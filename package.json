{
  "name": "wealthfolio-addons",
  "private": true,
  "description": "Monorepo for dpremoli's Wealthfolio add-ons and their shared kit",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./addons/*\" build",
    "bundle": "pnpm -r --filter \"./addons/*\" bundle",
    "test": "pnpm -r test",
    "type-check": "pnpm -r type-check",
    "check": "pnpm type-check && pnpm test && pnpm test:tooling && pnpm build",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,yml}\"",
    "test:tooling": "node --test tooling/tooling.test.mjs",
    "bump": "node tooling/bump-version.mjs",
    "release:plan": "node tooling/release-plan.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
