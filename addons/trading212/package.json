{
  "name": "trading212-addon",
  "version": "2.2.0",
  "private": true,
  "description": "Sync Trading 212 investment activity into Wealthfolio",
  "type": "module",
  "main": "dist/addon.js",
  "author": "dpremoli",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "dev:server": "wealthfolio dev",
    "clean": "rm -rf dist",
    "package": "node ../../tooling/package-addon.mjs",
    "bundle": "pnpm clean && pnpm build && pnpm package",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@wf-addons/kit": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/react-query": "catalog:",
    "@wealthfolio/addon-sdk": "catalog:",
    "@wealthfolio/ui": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@wealthfolio/addon-dev-tools": "^3.9.0",
    "@wealthfolio/addon-sdk": "catalog:",
    "@wealthfolio/ui": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
